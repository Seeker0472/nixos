max-history=10
max-visible=8

sort=-time

width=520
height=420

background-color=#2e34407f
border-color=#99c0d0
border-size=3
border-radius=12
margin=12
padding=12,20

default-timeout=120000
ignore-timeout=1

font='Maple Mono NF CN' 14

max-icon-size=34
icon-location=left

[urgency=low]
border-color=#cccccc
[urgency=normal]
border-color=#99c0d0
[urgency=critical]
border-color=#bf616a
default-timeout=0
[category=hitokoto]
border-color=#d8dee9
default-timeout=8000
[category=screenshoot]
default-timeout=5000
height=800
width=800
max-icon-size=1000
icon-location=bottom
on-button-left=exec makoctl dismiss -a;xdg-open /tmp/screenshot.png

[desktop-entry=org.kde.kdeconnect.daemon]
default-timeout=50000
border-color=#bbfac1
